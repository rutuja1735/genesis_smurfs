OPENROUTER_API_KEY=
OPENROUTER_MODEL=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_SITE_URL=http://localhost:3000
OPENROUTER_APP_NAME=Agentgaurd
LLM_TEMPERATURE=0
MAX_BUDGET_USD=4.00
PRICE_IN_PER_M=0.15
PRICE_OUT_PER_M=0.60
LLM_CACHE=1
LLM_MAX_RETRIES=3
LLM_TIMEOUT_S=60
LOG_PROMPTS=0
NEUTRALIZE_MODE=redact
OUTPUT_FILTER=1

# ── Real email agent ────────────────────────────────────────────────────────
# Which email agent to use: mock (default, safe for evals) | real
EMAIL_AGENT=mock

# Gmail scope: readonly | draft | full  (default: readonly)
# readonly  → gmail.readonly only          (no writes of any kind)
# draft     → gmail.readonly + gmail.compose (drafts only, no send)
# full      → gmail.modify + gmail.send    (read, modify, send)
REAL_EMAIL_MODE=readonly

# Dry-run: 1 (default) = writes are logged but not sent to the mailbox
# Set to 0 only after you have verified the allowlist and tested in readonly.
REAL_EMAIL_DRY_RUN=1

# Allowlist (comma-separated) of recipient addresses allowed for live sends.
# Leave empty to require explicit gate approval for every recipient.
# This is a last-resort backstop IN ADDITION TO the gate, not instead of it.
REAL_EMAIL_SEND_ALLOWLIST=

# Hard cap on live high-impact actions per process (default 3).
# Once reached the process must be restarted to perform more writes.
REAL_EMAIL_MAX_HIGH_IMPACT=3

# OAuth credentials (downloaded from Google Cloud Console)
GMAIL_CREDENTIALS_PATH=backend/.secrets/credentials.json

# Token cache (auto-created on first run; gitignored; mode 600)
GMAIL_TOKEN_PATH=backend/.secrets/gmail_token.json

# Maximum body length in characters before truncation (default 4000)
EMAIL_BODY_MAX_CHARS=4000

# Optional DMARC-fail escalation to NEEDS_CONFIRM for delegated sink values
# Set to 1 to enable; 0 (default) leaves existing R4/R4b behaviour unchanged.
DMARC_ESCALATE_ENABLED=0

# ── IMAP/SMTP fallback (optional; used when GMAIL_* is not set) ─────────────
IMAP_HOST=
IMAP_PORT=993
SMTP_HOST=
SMTP_PORT=587
EMAIL_USER=
# App password only (never your account password).  This value is masked in
# all audit logs and is never returned by any API endpoint.
EMAIL_PASSWORD=
